{
  "name": "kandev-plugin-stl",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "test:recipes": "vitest run recipes/source-control/ui",
    "typecheck:recipes": "tsc --project tsconfig.recipes.json --noEmit",
    "test:ui": "node --test tests/ui-action.test.js tests/smoke-http.test.js",
    "test:host": "node scripts/smoke-minimum-host.mjs",
    "build": "node scripts/build-ui.mjs",
    "test": "node --test tests/parser.test.js",
    "test:resource-limits": "node tests/measure-parser.mjs",
    "test:package-smoke": "node scripts/test-host.mjs",
    "test:e2e": "node scripts/test-host.mjs",
    "check": "node --check src/parser.js && node --check src/scene.js && node --check src/index.js && node --check src/worker.js"
  },
  "devDependencies": {
    "@kdlbs/plugin-sdk": "0.1.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "nanoid": "5.1.16"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "three": "0.187.0"
  }
}
